---
import { render } from 'astro:content';
import Article from '../layouts/Article.astro';
import Tours from '../components/Tours.astro';
import { relatedCards } from '../lib/related';
import { byPlace } from '../lib/tours';
import { src } from '../lib/photos';
import { destinationSchema, mapLink } from '../lib/site';
import { T, href, type Lang } from '../lib/i18n';

interface Props { entry: any; lang: Lang }
const { entry, lang } = Astro.props;
const t = T[lang];
const { Content, headings } = await render(entry);
const d = entry.data;
const path = href(lang, `/destinations/${entry.id}/`);
const related = await relatedCards(d.related, lang);
const tours = byPlace(d.place);
const crumbs = [
  { name: t.home, path: href(lang, '/') },
  { name: t.places, path: href(lang, '/destinations/') },
  { name: d.name, path },
];
const place = destinationSchema({ name: d.name, description: d.description, lat: d.lat, lng: d.lng, path, image: d.photo ? src(d.photo, 1600) : undefined });
---
<Article data={d} headings={[...headings, ...(tours.length ? [{ depth: 2, slug: 'tours', text: t.toursInclude(d.name) }] : [])]} crumbs={crumbs} related={related} extraSchema={[place]}>
  <ul class="fact" slot="before">
    <li><b>{t.timeNeeded}</b>{d.timeNeeded}</li>
    <li><b>{t.map}</b><a href={mapLink(d.lat, d.lng)} rel="noopener" target="_blank">{t.openMap}</a></li>
  </ul>
  <Content />
  <Fragment slot="after">
    {tours.length > 0 && (
      <section><h2 id="tours">{t.toursInclude(d.name)}</h2><Tours tours={tours} /></section>
    )}
  </Fragment>
</Article>
