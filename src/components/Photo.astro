---
import { photo, src, altText } from '../lib/photos';
import { T, langOf } from '../lib/i18n';
interface Props { slug?: string; class?: string; eager?: boolean; sizes?: string; caption?: boolean }
const { slug, class: cls, eager = false, sizes = '(min-width: 1040px) 46rem, 100vw', caption = false } = Astro.props;
const p = photo(slug);
const lang = langOf(Astro.url);
const attrs = p && {
  src: src(p.slug, 1600),
  srcset: `${src(p.slug, 800)} 800w, ${src(p.slug, 1600)} 1600w`,
  sizes,
  width: p.width,
  height: p.height,
  alt: altText(p, lang),
  loading: eager ? 'eager' : 'lazy',
  fetchpriority: eager ? 'high' : undefined,
  decoding: 'async',
  class: cls,
};
---
{p && attrs && (caption ? (
  <figure class="page-photo">
    <img {...attrs} />
    <figcaption>{altText(p, lang)}. {T[lang].photo}: {p.author}, <a href={p.sourceUrl} rel="nofollow">{p.license}</a>.</figcaption>
  </figure>
) : <img {...attrs} />)}
