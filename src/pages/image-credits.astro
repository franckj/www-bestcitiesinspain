---
import Simple from '../layouts/Simple.astro';
import { PHOTOS, src } from '../lib/photos';
---
<Simple title="Image credits" seoTitle="Image Credits | Best Cities in Spain" description="Photographers and licences for the photos used on Best Cities in Spain." path="/image-credits/">
  <p class="lede">Photos on this site are used under their authors' licences. Thank you to the photographers.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Photo</th><th>Author</th><th>Licence</th></tr></thead>
      <tbody>
        {PHOTOS.map((p) => (
          <tr>
            <td><a href={src(p.slug, 1600)}>{p.description}</a><br /><a href={p.sourceUrl} rel="nofollow">Source</a></td>
            <td>{p.author}</td>
            <td>{p.licenseUrl ? <a href={p.licenseUrl} rel="nofollow">{p.license}</a> : p.license}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>Photos were resized and converted to WebP. No other changes were made unless noted.</p>
</Simple>
