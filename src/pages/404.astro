---
import Base from '../layouts/Base.astro';
import Cards from '../components/Cards.astro';
import { relatedCards } from '../lib/related';
import { GUIDE_ORDER } from '../lib/site';
const cards = await relatedCards(GUIDE_ORDER);
---
<Base title="Page not found | Best Cities in Spain" description="This page doesn't exist." noindex>
  <div class="wrap"><div class="article" style="padding:2.5rem 0">
    <h1>This street doesn't go anywhere.</h1>
    <p class="lede">The page you're looking for doesn't exist or has moved. Start from the <a href="/">guide to the best cities in Spain</a>, or pick one of these.</p>
    <Cards items={cards} />
  </div></div>
</Base>
