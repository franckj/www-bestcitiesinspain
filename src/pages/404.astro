---
import BaseLayout from '../components/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="Page Not Found | Best Cities in Spain"
  description="This page doesn't exist. Browse our guide to Spain's greatest cities."
>
  <div style="max-width: 720px; margin: 0 auto; padding: 6rem 1.5rem; text-align: center;">
    <p class="text-7xl mb-6">🇪🇸</p>
    <h1
      class="font-bold mb-4"
      style="font-family: 'Playfair Display', Georgia, serif; color: #1A1A1A; font-size: 2rem; line-height: 1.2;"
    >
      This city doesn't exist (yet).
    </h1>
    <p class="mb-8" style="color: #6B7280; font-size: 1.05rem;">
      Maybe it should — we're always expanding our guide.
    </p>
    <a
      href="/"
      class="inline-block px-6 py-3 rounded-lg font-semibold text-white transition-opacity duration-200 hover:opacity-90"
      style="background-color: #B7472A;"
    >
      Back to the guide →
    </a>
  </div>
</BaseLayout>
