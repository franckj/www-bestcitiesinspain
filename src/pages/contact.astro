---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Best Cities in Spain"
  description="Get in touch with Best Cities in Spain — questions, corrections, suggestions, or press inquiries."
>
  <div style="max-width: 720px; margin: 0 auto; padding: 4rem 1.5rem;">
    <h1
      class="font-bold mb-8"
      style="font-family: 'Playfair Display', Georgia, serif; color: #1A1A1A; font-size: 2.25rem; line-height: 1.2;"
    >
      Contact
    </h1>

    <div class="prose-city">
      <p>
        Have a question, a correction, or a suggestion? We'd love to hear from you.
      </p>

      <p>
        Email: <a href="mailto:hola@bestcitiesinspain.com">hola@bestcitiesinspain.com</a>
      </p>

      <p>
        We typically respond within 48 hours. For press inquiries or partnership proposals, please use the same address.
      </p>
    </div>
  </div>
</BaseLayout>
